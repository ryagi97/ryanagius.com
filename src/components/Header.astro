---
import { site, withBase } from '../data/site';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/blog', label: 'Blog' },
  { href: '/travel', label: 'Travel' },
].map((l) => ({ ...l, href: withBase(l.href) }));

const normalizePath = (path: string) => (path === '/' ? path : `${path.replace(/\/+$/, '')}/`);
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={withBase('/')}>
      <span aria-hidden="true">&gt;</span> {site.shortTitle}
      <span>_</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={currentPath === normalizePath(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
